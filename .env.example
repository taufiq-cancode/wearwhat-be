# Copy to .env. Anything left empty falls back to the safe behaviour described beside it.

# development enables test payments, on-screen codes, /dev/outbox and auto-verified brands.
# Any other value (or unset) behaves as production.
APP_ENV=development
PORT=8080
# Browser origin(s) allowed to call the API, comma separated. The first one is used for links in
# emails and for returning from payment, so list the app's main address first.
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://wearwhat:wearwhat@localhost:5433/wearwhat?sslmode=disable
# Time zone used for dates and times shown to people.
APP_TZ=Africa/Lagos
# Serves the built frontend with SPA fallback when set, e.g. ../wearwhat/dist
STATIC_DIR=
# Where uploads go when CLOUDINARY_URL isn't set (development only).
UPLOAD_DIR=./data/uploads
# How many proxies sit in front of the server, used to find the real client address for rate
# limits. 0 ignores X-Forwarded-For. See "Going to production" in the README.
TRUSTED_PROXY_HOPS=0
# Load the demo catalog and demo logins into an empty database at startup. Refused in production.
SEED_DEMO=true
SUPPORT_EMAIL=support@wearwhat.site

# Encrypts identity documents, national ID numbers, bank accounts and saved-card tokens at rest.
# Base64 of 32 random bytes. Required in production. Generate one with: openssl rand -base64 32
DATA_KEY=

# Email through Resend. Without a key, messages print to the server console (development only).
RESEND_API_KEY=
# An address on a domain verified in Resend. Required whenever RESEND_API_KEY is set.
# Example: wearwhat <hello@wearwhat.site>
MAIL_FROM=

# Images, videos and encrypted documents, from Cloudinary's dashboard (API Keys):
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Without it, files go to UPLOAD_DIR (development only).
CLOUDINARY_URL=

# SMS (Termii). Without a key, phone sign-up is hidden.
TERMII_API_KEY=
TERMII_SENDER=wearwhat
TERMII_BASE_URL=https://api.ng.termii.com

# Sign in with Apple. Without a client id the button is hidden.
APPLE_CLIENT_ID=
APPLE_KEYS_URL=https://appleid.apple.com/auth/keys

# Paystack. Without a secret key, checkout runs in labelled test mode (development only).
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Currency charged at Paystack. Prices are stored in USD, so anything else needs FX_RATE: the
# number of PAYMENT_CURRENCY units per 1 USD, e.g. PAYMENT_CURRENCY=NGN and FX_RATE=1500.
# The server refuses to start if these two don't make sense together.
PAYMENT_CURRENCY=USD
FX_RATE=1

# Only for `LIVE_TESTS=1 go test`, which sends a real email to this address.
LIVE_TEST_EMAIL=

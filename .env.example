# Copy to .env. Anything left empty falls back to the safe behaviour described beside it.

# development enables test payments, on-screen codes, /dev/outbox and auto-verified brands.
# Any other value (or unset) behaves as production.
APP_ENV=development
PORT=8080
# Browser origin(s) allowed to write to the API, comma separated.
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://wearwhat:wearwhat@localhost:5433/wearwhat?sslmode=disable
# Time zone used for dates and times shown to people.
APP_TZ=Africa/Lagos
# Serves the built frontend with SPA fallback when set, e.g. ../wearwhat/dist
STATIC_DIR=
UPLOAD_DIR=./data/uploads
# Set true only behind a reverse proxy you control, so client IPs come from X-Forwarded-For.
TRUST_PROXY=false
# Load the demo catalog and demo logins into an empty database at startup. Refused in production.
SEED_DEMO=true
SUPPORT_EMAIL=support@wearwhat.com

# Encrypts national ID numbers, bank accounts and saved-card tokens at rest. Base64 of 32 random bytes.
# Required in production. Generate one with: openssl rand -base64 32
DATA_KEY=

# Email. Without SMTP_HOST, messages print to the server console (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=wearwhat <hello@wearwhat.com>

# SMS (Termii). Without a key, phone sign-up is hidden.
TERMII_API_KEY=
TERMII_SENDER=wearwhat
TERMII_BASE_URL=https://api.ng.termii.com

# Sign in with Apple. Without a client id the button is hidden.
APPLE_CLIENT_ID=
APPLE_KEYS_URL=https://appleid.apple.com/auth/keys

# Paystack. Without a secret key, checkout runs in labelled test mode (development only).
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Currency charged at Paystack. Prices are stored in USD, so anything else needs FX_RATE:
# the number of PAYMENT_CURRENCY units per 1 USD, e.g. PAYMENT_CURRENCY=NGN and FX_RATE=1500.
PAYMENT_CURRENCY=USD
FX_RATE=1
